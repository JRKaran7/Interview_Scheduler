# ── Mandatory Environment Variables for Vercel Deployment ────────────────────

# Secret key used to sign & verify student session cookies.
# (If omitted, the app will fall back to GOOGLE_PRIVATE_KEY)
SESSION_SECRET=your_random_secret_string_here

# Google Sheets Integration
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_CLIENT_EMAIL=your_service_account_email@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourPrivateKeyHere\n-----END PRIVATE KEY-----\n"

# ── Email Provider Configuration (Optional) ──────────────────────────────────
# Choose ONE of Brevo, Resend, or Gmail:

# Option A: Brevo (Recommended for Vercel)
BREVO_API_KEY=xkeysib-your-api-key
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME="Interview Scheduler"

# Option B: Resend
RESEND_API_KEY=re_123456789
RESEND_FROM_EMAIL=onboarding@resend.dev

# Option C: Gmail SMTP
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
